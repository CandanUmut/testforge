# TestForge self-hosted configuration
# Copy to deploy/.env and fill in. Nothing here leaves your network.

# ── Frontend build (Vite) ────────────────────────────────────────────────
# Point the dashboard at your in-lab Supabase instance.
VITE_SUPABASE_URL=https://testforge.lab.internal
VITE_SUPABASE_ANON_KEY=your_self_hosted_anon_key
# Serve the SPA at the domain root instead of /testforge/.
VITE_BASE=/

# ── Self-hosted Supabase (see supabase/docker .env) ──────────────────────
# These belong to your Supabase stack; listed here so you know what TestForge
# needs. Generate strong, unique values — never reuse the demo defaults.
POSTGRES_PASSWORD=change_me_long_random
JWT_SECRET=change_me_40+_char_random
ANON_KEY=generated_from_jwt_secret
SERVICE_ROLE_KEY=generated_from_jwt_secret
SITE_URL=https://testforge.lab.internal

# ── Migration apply helper ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:change_me_long_random@localhost:5432/postgres

# ── Agent / reporter (runs inside the lab) ───────────────────────────────
TESTFORGE_URL=https://testforge.lab.internal
TESTFORGE_API_KEY=tf_generate_in_settings_after_first_login
